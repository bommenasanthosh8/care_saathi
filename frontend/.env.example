# CareSaathi AI - Frontend Environment Variables

# Google Maps JavaScript API (Client Browser Key)
# Restricted by HTTP Referrer in Google Cloud Console to:
# http://localhost:5173/*, http://127.0.0.1:5173/*, and your production URL
VITE_GOOGLE_MAPS_API_KEY=""

# Supabase Client Configuration (Optional: fallback Demo mode is automatic)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Backend Python API URL
VITE_API_URL="http://127.0.0.1:8000"
