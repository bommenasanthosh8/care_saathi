# CareSaathi AI - Environment Configuration

APP_NAME="CareSaathi AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEMO_MODE=true

# Security Configuration
# In production (ENVIRONMENT=production), JWT_SECRET must be set and at least 32 characters long
JWT_SECRET=""
# Comma-separated allowed frontend origins for CORS (e.g. https://yourdomain.com,http://localhost:5173)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"

# Optional Razorpay Payment Gateway (Production payments require real credentials and signatures)
# If omitted or in DEMO_MODE, transparent simulation mode is used for demonstration
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional SMS Gateway Provider for Mobile OTP Verification (e.g. Fast2SMS / Twilio)
# If omitted or in DEMO_MODE, simulated OTP verification (code 7829) is enabled
SMS_PROVIDER_API_KEY=""

# Database Configuration (Backend SQLite)
# Defaults deterministically to caresaathi.db in project root
DATABASE_PATH="caresaathi.db"

# Server Ports
PORT=8000
FRONTEND_PORT=5173

# Frontend Public Keys (Vite)
# Maps JavaScript API key (Browser client only, restrict by HTTP referrer to your domain/localhost)
VITE_GOOGLE_MAPS_API_KEY=""
# Optional Map ID for Advanced Markers styling in Maps JavaScript API
VITE_GOOGLE_MAPS_MAP_ID=""

# Supabase Configuration (Optional - falls back seamlessly to DemoRepository)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_API_URL="http://127.0.0.1:8000"

# Google Gemini API Configuration (Prescription OCR Multimodal Vision)
# Required for handwritten prescription extraction via official google-genai SDK
# Server-side only - NEVER expose in frontend!
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Supabase Edge Functions Secret Keys (Server only - NEVER expose in frontend!)
# Used by edge functions: places-nearby, place-details, place-photo, route-matrix, geocode
GOOGLE_MAPS_SERVER_KEY=""

# Geospatial API Adapters (OpenStreetMap / Overpass - used as fallback when Google keys are omitted)
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_URL="https://nominatim.openstreetmap.org"
USER_AGENT="CareSaathiAI/1.0 (healthcare-navigation-hackathon)"
